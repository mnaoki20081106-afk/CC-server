{
  "name": "cc-server-bot",
  "version": "1.0.0",
  "description": "CC-Server: Discord-Bot + Discord-Security 統合Discordサーバー管理 (管理サイト + Cloudflare Worker) / Amazon自販機",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/worker"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @cc/web",
    "dev:worker": "npm run dev --workspace @cc/worker",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "deploy:worker": "cd apps/worker && npx wrangler deploy",
    "typecheck:legacy-amazon": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
