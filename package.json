{
  "name": "cc-server-bot",
  "version": "1.0.0",
  "description": "CC-Server Discord bot: server management, security, auth, entry/exit, tickets, panels, vending, backup",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
