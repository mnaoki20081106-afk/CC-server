# CC-Server は Cloudflare Worker (apps/worker/) で動きます。
# 値は Bot-Factory でデプロイするか、`wrangler secret put <NAME>` で Worker Secret として設定してください。
# (このファイルはローカルの wrangler dev 用 .dev.vars の見本です)

# --- 必須 ---
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=
# 32文字以上のランダム文字列
SESSION_ENCRYPTION_KEY=
# 管理サイトのログインパスワード
DASHBOARD_PASSWORD=
# Amazon自販機 (ローソン店舗確認 / Places API (New))
GOOGLE_PLACES_API_KEY=

# --- 任意: Discord-Security を別Botで動かす場合 ---
# 未設定ならメインBOTがセキュリティ機能も担当します。
SECURITY_DISCORD_BOT_TOKEN=
SECURITY_DISCORD_APPLICATION_ID=

# --- 任意: 外部の Discord-Security Worker に接続する場合 ---
# 設定すると内蔵Securityは使わず、従来どおり別Workerへ署名付きで接続します。
# SECURITY_API_BASE_URL=https://discord-security.<account>.workers.dev
# SECURITY_BRIDGE_SECRET=<32文字以上・Security Workerと同じ値>

# --- 任意: 仕入れBot連携 ---
# SHIIRE_BRIDGE_SECRET=
