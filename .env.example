DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: restrict slash command deploy to one guild during development
DEV_GUILD_ID=
# Absolute or relative path to the sqlite db file
DB_PATH=./data/bot.sqlite
# Directory where /backup create writes JSON snapshots
BACKUP_DIR=./data/backups

# 管理サイトはCloudflare Worker (apps/worker/) で動きます。
# Bot-Factoryでデプロイするか、wrangler secretsで直接設定してください。
# DISCORD_BOT_TOKEN / DISCORD_APPLICATION_ID / DISCORD_PUBLIC_KEY / DASHBOARD_PASSWORD
