DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: restrict slash command deploy to one guild during development
DEV_GUILD_ID=
# Absolute or relative path to the sqlite db file
DB_PATH=./data/bot.sqlite
# Directory where /backup create writes JSON snapshots
BACKUP_DIR=./data/backups

# Amazon自販機 — APIキーとLTCアドレスはDiscordの /amazon-vending config で設定
# (DB保存のためここへの記載は不要)
